# Copia in `.env.local` (ignorato da git) e adatta i valori. Tutte le variabili sono lette da
# `src/config/env.ts` (e `src/config/auth.ts` per la sessione) con default sicuri: senza file
# l'app parte interamente in modalità mock.

# --- Provider (Regola d'Oro Mock-First) -------------------------------------------------
# Default globale e override per porta: mock | real. Oggi "real" esiste per Infinity (ODBC, sotto)
# e Spoki (in fondo); SMS e CRM reali non sono ancora implementati (fail-fast all'avvio).
SERVICES_PROVIDER=mock
INFINITY_PROVIDER=mock
SPOKI_PROVIDER=mock
SMS_PROVIDER=mock
CRM_PROVIDER=mock
# Persistenza: memory | prisma (prisma arriva con M7).
REPOSITORY_PROVIDER=memory
# Storage media: local (file su disco, predefinito) | memory (solo test) | blob (futuro).
MEDIA_STORAGE_PROVIDER=local
# Cartella dei file caricati quando lo storage è "local" (fuori dal repository, come lo snapshot).
MEDIA_STORAGE_DIR=.data/uploads

# --- Officina ----------------------------------------------------------------------------
# Fuso dell'officina (zona IANA). Volutamente NON si usa TZ (nei container è spesso UTC).
APP_TIMEZONE=Europe/Rome
# Ora locale della sincronizzazione giornaliera dell'agenda Infinity.
SYNC_HOUR_LOCAL=06:00
# Ora locale di fine turno: dopo, la giornata si chiude da sola (assenti + prese in carico aperte).
BUSINESS_DAY_END_TIME=19:00
# Codici progressivi: prefisso e ambito del contatore (SITE = unico per sede, BRAND = per marchio).
CODE_PREFIX=F
CODE_SEQUENCE_SCOPE=SITE
# Nota: il conteggio "clienti prima di te" del portale considera sempre e solo lo stesso
# sportello della pratica cercata (regola fissa, non configurabile).

# --- Sessione operatore ------------------------------------------------------------------
# Segreto HS256 dei JWT di sessione (minimo 32 caratteri). Se assente, in sviluppo con tutti i
# provider mock viene usato un valore di default; in produzione o con provider reali è
# obbligatorio (ConfigurationError all'avvio).
SESSION_SECRET=

# --- Interruttori dei mock ---------------------------------------------------------------
MOCK_SEED=officina-2026
MOCK_LATENCY_MS=150
# Infinity: ok | empty | partial | error | timeout | flaky
MOCK_INFINITY_MODE=ok
MOCK_INFINITY_FLAKY_FAILURES=2
MOCK_INFINITY_CANCEL_ON_SECOND_CALL=false
# Spoki (WhatsApp): esito deciso dall'ultima cifra del telefono (9 = errore → fallback SMS).
MOCK_SPOKI_MODE=ok
MOCK_SPOKI_FAIL_SUFFIX=9
MOCK_SPOKI_FAILURE_RATE=
# SMS Hosting
MOCK_SMS_MODE=ok
MOCK_SMS_FAIL_SUFFIX=99
MOCK_SMS_FAILURE_RATE=
MOCK_SMS_CREDITS=500
# CRM / BDC
MOCK_CRM_MODE=ok
# Rinvii automatici degli eventi CRM dal processo dell'app: false quando li fa un cron esterno.
CRM_RETRY_ENABLED=true
# Segreto per il cron esterno (intestazione x-cron-secret su /api/v1/system/cron/crm-retry).
CRON_SECRET=
# Token obbligatorio per i monitor (?token=): true quando gli schermi non stanno su una rete fidata.
DISPLAY_TOKEN_REQUIRED=false
# Messaggi al cliente guidati dagli eventi (conferma inserimento manuale, turno vicino, annullamento).
MESSAGING_TRIGGERS_ENABLED=true
# Ritardo simulato della conferma di consegna WhatsApp (ms).
MOCK_DELIVERY_DELAY_MS=0
# Giorni di conservazione dei file delle foto dell'ispezione (i record restano, i file spariscono).
PHOTO_RETENTION_DAYS=30
# Giorni dopo l'archiviazione oltre i quali anche il record della foto viene eliminato dal database.
PHOTO_HARD_DELETE_DAYS=90
# Ritardo simulato del salvataggio delle foto dal tablet (ms): vale solo per lo storage "memory".
MOCK_MEDIA_LATENCY_MS=1200

# --- Spoki (WhatsApp) reale, con SPOKI_PROVIDER=real -----------------------------------------
# GUARDRAIL: nessun cliente reale riceve WhatsApp finché SPOKI_MODE non è "live" E SPOKI_SAFETY_LOCK
# non è "false". Con il blocco attivo i payload vengono solo formattati, scritti nel log e nel
# registro di /admin (o /admin/spoki-test). Entrambe le condizioni vanno cambiate a mano.
SPOKI_MODE=simulation
SPOKI_SAFETY_LOCK=true
# Chiave API globale dell'account (Spoki → Integrazioni API); facoltativa: l'autenticazione delle
# automazioni è il segreto nel payload.
SPOKI_API_KEY=
# Le due automazioni integrate in questa fase. Ogni automazione riceve un POST JSON nel formato
# Spoki: { secret, phone, first_name, last_name, email, custom_fields: { code, plate, time, date,
# portal_url } }. URL e segreto si copiano dalla pagina dell'automazione in Spoki.
# I valori veri stanno SOLO in .env.local (ignorato da git).
SPOKI_URL_REMINDER_PREVIOUS_DAY=https://api.spoki.com/wh/ap/<id-automazione-giorno-prima>/
SPOKI_SECRET_REMINDER_PREVIOUS_DAY=
SPOKI_URL_REMINDER_SAME_DAY=https://api.spoki.com/wh/ap/<id-automazione-giorno-stesso>/
SPOKI_SECRET_REMINDER_SAME_DAY=
# Automazioni degli altri messaggi (conferma inserimento manuale, turno in arrivo, annullamento):
# NON integrate in questa fase, restano vuote.
SPOKI_URL_CONFIRMATION=
SPOKI_URL_TURN_APPROACHING=
SPOKI_URL_CANCELLATION=
# Indirizzo pubblico del portale cliente, usato nei link dei messaggi (/portal?targa=...).
PUBLIC_BASE_URL=http://localhost:3000
# Promemoria programmati: interruttore e ore locali. Il giorno prima anticipa la sync di domani
# (le pratiche hanno già il codice) e scrive a chi è in attesa domani; il giorno stesso scrive la
# mattina a chi è in coda oggi, dopo la sync. Entrambi idempotenti per pratica e giornata.
REMINDERS_ENABLED=true
REMINDER_PREVIOUS_DAY_HOUR_LOCAL=18:00
REMINDER_SAME_DAY_HOUR_LOCAL=07:30

# --- Infinity (Zucchetti, motore SQL Anywhere 12) via ODBC, con INFINITY_PROVIDER=real ------------
# Nome del DSN ODBC di sistema a 64 bit (driver "SQL Anywhere 12"). Il DSN porta di norma host,
# porta, nome server e credenziali: l'app passa solo il nome. Prova: Infinity02. Produzione:
# Infinity01 (si cambia solo questa variabile).
INFINITY_ODBC_DSN=
# Motore del database: oggi solo sql_anywhere_12.
INFINITY_DB_TYPE=sql_anywhere_12
# Utente e password SOLO se il DSN non li memorizza. Mai nel repository: solo in .env.local.
INFINITY_ODBC_UID=
INFINITY_ODBC_PWD=
# Proprietario delle tabelle applicative di Infinity (tdo_pre, off_veicoli, ...).
INFINITY_DB_SCHEMA=DBA
# Tipi documento (tipi_doc.codice) che rappresentano una prenotazione del planning, separati da virgola.
INFINITY_BOOKING_DOC_TYPES=PR01
# Tempi massimi (secondi) per aprire la connessione e per una query.
INFINITY_ODBC_LOGIN_TIMEOUT_SEC=10
INFINITY_ODBC_QUERY_TIMEOUT_SEC=60
# Sorgente del planning: auto (predefinito: procedura nativa sp_off_docs_planning se concessa, altrimenti
# tabelle) | procedure | tables. La procedura vede anche cancellate/chiuse; richiede GRANT EXECUTE.
INFINITY_PLANNING_SOURCE=auto
# Codice sede per la procedura (tipi_doc.sede_cont, es. 01 = Bari). Vuoto = ricavato dai tipi documento.
INFINITY_SEDE=
# Includere anche le commesse in consegna (genere L) oltre alle prenotazioni: di norma false.
INFINITY_INCLUDE_WORK_ORDERS=false
