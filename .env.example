# Copia in `.env.local` (ignorato da git) e adatta i valori. Tutte le variabili sono lette da
# `src/config/env.ts` (e `src/config/auth.ts` per la sessione) con default sicuri: senza file
# l'app parte interamente in modalità mock.

# --- Provider (Regola d'Oro Mock-First) -------------------------------------------------
# Default globale e override per porta: mock | real. Oggi "real" esiste per Infinity (ODBC, sotto)
# e Spoki (in fondo); SMS e CRM reali non sono ancora implementati (fail-fast all'avvio).
SERVICES_PROVIDER=mock
INFINITY_PROVIDER=mock
SPOKI_PROVIDER=mock
SMS_PROVIDER=mock
CRM_PROVIDER=mock
# Persistenza: memory | prisma (prisma arriva con M7).
REPOSITORY_PROVIDER=prisma
# Database SQLite (con REPOSITORY_PROVIDER=prisma): un file dentro .data/, fuori da git, che si copia per il backup.
# Le migrazioni si applicano con `npm run db:migrate`; `memory` resta per test e dimostrazioni usa e getta.
DATABASE_URL=file:./.data/accettazione.db
# Storage media: local (file su disco, predefinito) | memory (solo test) | blob (futuro).
MEDIA_STORAGE_PROVIDER=local
# Cartella dei file caricati quando lo storage è "local" (fuori dal repository, come lo snapshot).
MEDIA_STORAGE_DIR=.data/uploads

# --- Dati di riferimento (seed) ----------------------------------------------------------
# demo (predefinito): marchi e operatori di prova, password "demo", token display prevedibili: SOLO
# sviluppo, il container li rifiuta con un provider reale o NODE_ENV=production.
# real: officina di Bari (2 sportelli, marchi del planning Infinity più «Altri marchi» di ripiego) e un
# solo account "admin" con password da cambiare al primo accesso; gli accettatori si creano da /admin.
# I tre valori sotto si generano con `npm run seed:credenziali` e vivono SOLO in .env.local.
SEED_PROFILE=demo
SEED_ADMIN_PASSWORD_HASH=
SEED_DISPLAY_TOKEN_SECRET=

# --- Interfaccia e sviluppo ---------------------------------------------------------------
# Pulsante «Pratica manuale» nella dashboard: none (default: nascosto a tutti) | managers (solo
# responsabili e amministratori) | all. L'inserimento avviene a monte in Infinity (BDC).
UI_MANUAL_INTAKE=none
# Accesso veloce nella pagina di login (pulsanti per ruolo, account dev.* senza credenziali): acceso
# di default solo quando TUTTO è mock; con dati reali (Prisma, Infinity) va chiesto esplicitamente e
# vale come porta aperta a chiunque raggiunga il server. Sempre spento con NODE_ENV=production.
DEV_QUICK_LOGIN=true

# --- Rete e sicurezza -------------------------------------------------------------------------
# Fiducia in X-Forwarded-For / X-Real-IP: true SOLO dietro un reverse proxy (Nginx, Caddy, IIS) che
# li sovrascrive. Senza proxy l'indirizzo lo scrive il client: i contatori per indirizzo non si
# applicano e restano quelli globali e per soggetto (targa, token, utente).
TRUST_PROXY_HEADERS=false
# «Sono qui» e «In ritardo» dal portale richiedono il token personale del link WhatsApp: con la sola
# targa (QR) si può soltanto consultare. Accendere quando i link con token sono in uso.
PORTAL_WRITES_REQUIRE_TOKEN=false
# Segreto per gli endpoint cron esterni (x-cron-secret): almeno 32 caratteri, altrimenti ignorato.
CRON_SECRET=

# --- Officina ----------------------------------------------------------------------------
# Fuso dell'officina (zona IANA). Volutamente NON si usa TZ (nei container è spesso UTC).
APP_TIMEZONE=Europe/Rome
# Ora locale della sincronizzazione giornaliera dell'agenda Infinity (produzione: 06:00, prima
# dell'apertura; una sync a metà mattina metterebbe subito fra gli assenti le prenotazioni delle 08:00).
SYNC_HOUR_LOCAL=06:00
# Ora locale di fine turno: dopo, la giornata si chiude da sola (assenti + prese in carico aperte).
BUSINESS_DAY_END_TIME=19:00
# Codici progressivi: prefisso e ambito del contatore (SITE = unico per sede, BRAND = per marchio).
CODE_PREFIX=F
CODE_SEQUENCE_SCOPE=SITE
# Nota: il conteggio "clienti prima di te" del portale considera sempre e solo lo stesso
# sportello della pratica cercata (regola fissa, non configurabile).

# --- Sessione operatore ------------------------------------------------------------------
# Segreto HS256 dei JWT di sessione (minimo 32 caratteri). Se assente, in sviluppo con tutti i
# provider mock viene usato un valore di default; in produzione o con provider reali è
# obbligatorio (ConfigurationError all'avvio).
SESSION_SECRET=

# --- Interruttori dei mock ---------------------------------------------------------------
MOCK_SEED=officina-2026
MOCK_LATENCY_MS=150
# Infinity: ok | empty | partial | error | timeout | flaky
MOCK_INFINITY_MODE=ok
MOCK_INFINITY_FLAKY_FAILURES=2
MOCK_INFINITY_CANCEL_ON_SECOND_CALL=false
# Spoki (WhatsApp): esito deciso dall'ultima cifra del telefono (9 = errore → fallback SMS).
MOCK_SPOKI_MODE=ok
MOCK_SPOKI_FAIL_SUFFIX=9
MOCK_SPOKI_FAILURE_RATE=
# SMS Hosting
MOCK_SMS_MODE=ok
MOCK_SMS_FAIL_SUFFIX=99
MOCK_SMS_FAILURE_RATE=
MOCK_SMS_CREDITS=500
# CRM / BDC
MOCK_CRM_MODE=ok
# Rinvii automatici degli eventi CRM dal processo dell'app: false quando li fa un cron esterno.
CRM_RETRY_ENABLED=true
# Riprova automatica dei messaggi al cliente falliti per un problema temporaneo (dopo 1, 5 e 15
# minuti, poi «da contattare a mano» nella schermata Comunicazioni). Spenta anche da MESSAGING_STANDBY.
NOTIFICATION_RETRY_ENABLED=true
# Segreto per il cron esterno (intestazione x-cron-secret su /api/v1/system/cron/crm-retry).
CRON_SECRET=
# Token obbligatorio per i monitor (?token=): true quando gli schermi non stanno su una rete fidata.
DISPLAY_TOKEN_REQUIRED=false
# Messaggi al cliente guidati dagli eventi (conferma inserimento manuale, turno vicino, annullamento).
MESSAGING_TRIGGERS_ENABLED=true
# STANDBY dell'integrazione con il cliente: promemoria, messaggi a evento e webhook delle risposte
# restano nel codice ma non partono. Serve a lavorare in locale senza credenziali Spoki e senza
# errori nei log. Togliere (o mettere false) per riaccendere tutto.
MESSAGING_STANDBY=false
# Ritardo simulato della conferma di consegna WhatsApp (ms).
MOCK_DELIVERY_DELAY_MS=0
# Giorni di conservazione dei FILE di foto e video dell'ispezione: la pulizia è automatica, nessun
# operatore deve cancellare niente. 90 = tre mesi, il tempo in cui un cliente può ancora contestare
# un danno; 60 se il disco stringe (con i video da 80 MB lo spazio cresce in fretta). I record
# restano comunque: dicono che il giro era stato fatto, anche quando il file non c'è più.
# Il vecchio nome PHOTO_RETENTION_DAYS vale ancora, ma questo ha la precedenza.
MEDIA_RETENTION_DAYS=90
# Giorni dopo l'archiviazione oltre i quali anche il record del media viene eliminato dal database
# (vecchio nome: PHOTO_HARD_DELETE_DAYS).
MEDIA_HARD_DELETE_DAYS=90
# Ritardo simulato del salvataggio delle foto dal tablet (ms): vale solo per lo storage "memory".
MOCK_MEDIA_LATENCY_MS=1200

# --- Spoki (WhatsApp Business API) reale, con SPOKI_PROVIDER=real -----------------------------
# INTERRUTTORE: con SPOKI_ENABLED=false (predefinito) o senza SPOKI_API_KEY l'integrazione lavora in
# simulazione qualunque cosa dica SPOKI_MODE: i messaggi vengono formattati e scritti nel registro,
# nessun credito WhatsApp viene consumato. È il modo di provare l'app senza toccare Spoki.
SPOKI_ENABLED=false
# GUARDRAIL: nessun cliente reale riceve WhatsApp finché SPOKI_MODE non è "live" E SPOKI_SAFETY_LOCK
# non è "false" (oltre a SPOKI_ENABLED=true e alla chiave API). Con il blocco attivo i payload vengono
# solo formattati, scritti nel log e nel registro di /admin (o /admin/spoki-test).
SPOKI_MODE=simulation
SPOKI_SAFETY_LOCK=true
# Consenso WhatsApp: l'anagrafica Infinity non ha un opt-in WhatsApp, quindi di norma senza consenso il
# promemoria va diretto all'SMS. Con true i promemoria (comunicazioni di servizio sull'appuntamento
# già preso) tentano comunque WhatsApp. Non tocca il guardrail: in simulazione o con SAFETY_LOCK nulla parte.
SPOKI_OVERRIDE_CONSENT=false
# Chiave API dell'account (Spoki → Integrazioni API), intestazione X-Spoki-Api-Key: serve ai
# template inviati via API (messaggi del check-in) e accende l'integrazione insieme a SPOKI_ENABLED.
# Le automazioni dei promemoria autenticano invece con il segreto nel payload.
SPOKI_API_KEY=
# Base delle API Spoki (percorsi /api/1/…); si cambia solo per prove contro un ambiente diverso.
SPOKI_API_BASE_URL=https://api.spoki.com
# I due messaggi del check-in partono via API con il template approvato da Meta, per id (si legge
# nella pagina del template in Spoki): alla presa in carico il benvenuto con il link PERSONALE al
# portale (custom_fields.portal_url), a check-in concluso «Procedura di accettazione completata».
# Vuoti = non configurati: in live il messaggio ripiega sull'SMS, in simulazione finisce nel registro.
SPOKI_TEMPLATE_WELCOME_ID=
SPOKI_TEMPLATE_COMPLETE_ID=
# Promemoria e risposte automatiche via API, per id del template approvato:
# - giorno prima: «Gentile cliente, le ricordiamo il suo appuntamento in AutoClub per domani {{data}}
#   alle ore {{ora}} per la vettura targa {{targa}}. A domani!» (custom_fields date, time, plate);
# - giorno stesso: «Buongiorno! Le ricordiamo l'appuntamento di oggi alle ore {{ora}} per la vettura
#   {{targa}}. Per aiutarci a gestire la fila, selezioni un'opzione:» con TRE pulsanti rapidi
#   «Sono arrivato», «In ritardo», «Non posso venire»; l'app invia i payload ACTION_ARRIVED,
#   ACTION_LATE, ACTION_ABSENT (buttons[].payload) e li riceve nel webhook message.inbound;
# - le tre risposte automatiche ai pulsanti: codice e smart link /portal/<token> a chi è arrivato,
#   conferma del ritardo, conferma dell'annullamento (custom_fields code, portal_url).
# Se un promemoria ha l'id, parte via API al posto dell'automazione SPOKI_URL_* qui sotto.
SPOKI_TEMPLATE_REMINDER_D1_ID=
SPOKI_TEMPLATE_SAME_DAY_ID=
SPOKI_TEMPLATE_ARRIVED_REPLY_ID=
SPOKI_TEMPLATE_LATE_REPLY_ID=
SPOKI_TEMPLATE_ABSENT_REPLY_ID=
# Risposta a chi tocca «Sono arrivato» troppo presto (vedi SPOKI_MAX_EARLY_ARRIVAL_MINUTES).
SPOKI_TEMPLATE_EARLY_REPLY_ID=
# GUARDRAIL sull'arrivo: «Sono arrivato» vale solo da questi minuti prima dell'orario in avanti.
# Prima, la pratica non entra in fila e il cliente riceve il messaggio che spiega quando ripremere
# («Il tuo appuntamento in AutoClub è previsto per le {ora}. È ancora un po' presto…»). «In ritardo»
# e «Non posso venire» non hanno finestra. 0 = solo dall'orario in avanti.
SPOKI_MAX_EARLY_ARRIVAL_MINUTES=60
# Segreto dei webhook V2 di Spoki (Integrazioni → Webhook, eventi message.outbound e message.inbound,
# URL <PUBLIC_BASE_URL>/api/v1/webhooks/spoki): verifica la firma X-Spoki-Signature degli esiti di
# consegna (inviato, consegnato, letto, fallito), che finiscono sulla pratica in coda e in archivio.
# Vuoto = gli esiti non vengono accettati (404). Minimo 16 caratteri.
SPOKI_WEBHOOK_SECRET=
# Le due automazioni integrate in questa fase. Ogni automazione riceve un POST JSON nel formato
# Spoki: { secret, phone, first_name, last_name, email, custom_fields: { code, plate, time, date,
# portal_url } }. URL e segreto si copiano dalla pagina dell'automazione in Spoki.
# I valori veri stanno SOLO in .env.local (ignorato da git).
SPOKI_URL_REMINDER_PREVIOUS_DAY=https://api.spoki.com/wh/ap/<id-automazione-giorno-prima>/
SPOKI_SECRET_REMINDER_PREVIOUS_DAY=
SPOKI_URL_REMINDER_SAME_DAY=https://api.spoki.com/wh/ap/<id-automazione-giorno-stesso>/
SPOKI_SECRET_REMINDER_SAME_DAY=
# Automazioni degli altri messaggi (conferma inserimento manuale, turno in arrivo, annullamento):
# NON integrate in questa fase, restano vuote.
# Risposte in entrata: il segreto che Spoki rimanda quando il cliente tocca «Arrivato»,
# «In ritardo» o «Assente» (corpo `secret` oppure intestazione `x-spoki-secret`).
# Vuoto = webhook spento: POST /api/v1/webhooks/spoki risponde 404.
SPOKI_INBOUND_SECRET=

SPOKI_URL_CONFIRMATION=
SPOKI_URL_TURN_APPROACHING=
SPOKI_URL_CANCELLATION=
# Indirizzo pubblico del portale cliente, usato negli smart link dei messaggi (/portal/<token>).
PUBLIC_BASE_URL=http://localhost:3000
# Promemoria programmati: interruttore e ore locali. Il giorno prima anticipa la sync di domani
# (le pratiche hanno già il codice) e scrive a chi è in attesa domani; il giorno stesso scrive la
# mattina a chi è in coda oggi, dopo la sync. Entrambi idempotenti per pratica e giornata.
REMINDERS_ENABLED=true
REMINDER_PREVIOUS_DAY_HOUR_LOCAL=18:00
REMINDER_SAME_DAY_HOUR_LOCAL=07:30

# --- Infinity (Zucchetti, motore SQL Anywhere 12) via ODBC, con INFINITY_PROVIDER=real ------------
# Nome del DSN ODBC di sistema a 64 bit (driver "SQL Anywhere 12"). Il DSN porta di norma host,
# porta, nome server e credenziali: l'app passa solo il nome. Prova: Infinity02. Produzione:
# Infinity01 (si cambia solo questa variabile).
INFINITY_ODBC_DSN=
# Motore del database: oggi solo sql_anywhere_12.
INFINITY_DB_TYPE=sql_anywhere_12
# Utente e password SOLO se il DSN non li memorizza. Mai nel repository: solo in .env.local.
INFINITY_ODBC_UID=
INFINITY_ODBC_PWD=
# Attributi ODBC aggiuntivi appesi alla stringa di connessione (prevalgono sul DSN), es. Host=ip:porta
# quando il DSN di sistema punta alla porta sbagliata. Di norma vuoto.
INFINITY_ODBC_EXTRA=
# Proprietario delle tabelle applicative di Infinity (tdo_pre, off_veicoli, ...).
INFINITY_DB_SCHEMA=DBA
# Tipi documento (tipi_doc.codice) che rappresentano una prenotazione del planning, separati da virgola.
INFINITY_BOOKING_DOC_TYPES=PR01
# Tempi massimi (secondi) per aprire la connessione e per una query.
INFINITY_ODBC_LOGIN_TIMEOUT_SEC=10
INFINITY_ODBC_QUERY_TIMEOUT_SEC=60
# Sorgente del planning: auto (predefinito: procedura nativa sp_off_docs_planning se concessa, altrimenti
# tabelle) | procedure | tables. La procedura vede anche cancellate/chiuse; richiede GRANT EXECUTE.
INFINITY_PLANNING_SOURCE=auto
# Codice sede per la procedura (tipi_doc.sede_cont, es. 01 = Bari). Vuoto = ricavato dai tipi documento.
INFINITY_SEDE=
# Riconsegne: le commesse in consegna (genere L, tipo R del planning) entrano come flusso RETURN,
# fuori dalla coda, nella scheda «Riconsegne» della dashboard con codici R001…. false = ignorarle.
INFINITY_INCLUDE_WORK_ORDERS=true

# Solo sviluppo: origini extra da cui il dev server accetta le proprie risorse (HMR, chunk), oltre agli
# indirizzi IPv4 della macchina che vengono rilevati da soli. Serve per un nome mDNS o un alias
# (es. lrossinb.local) quando si prova dall'iPad in Wi-Fi. Separati da virgola. In produzione è ignorato.
ALLOWED_DEV_ORIGINS=
# Il dev server accetta di norma qualunque indirizzo di rete privata (10.*, 172.16-31.*, 192.168.*)
# e i nomi *.local, così un IP del PC cambiato dopo l'avvio non blocca l'iPad. false = solo gli
# indirizzi rilevati all'avvio e quelli di ALLOWED_DEV_ORIGINS. In produzione è ignorato.
ALLOWED_DEV_ORIGINS_LAN=true
